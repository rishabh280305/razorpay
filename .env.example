# Server-only Razorpay TEST MODE credentials. Never expose RAZORPAY_KEY_SECRET.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Optional managed Postgres connection for durable production records.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional hosted LLM. The app uses a deterministic demo fallback when omitted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Required only for authenticated catalog writes. Never expose this to the browser.
CATALOG_ADMIN_KEY=replace_with_a_long_random_value
NEXT_PUBLIC_APP_URL=http://localhost:3000
